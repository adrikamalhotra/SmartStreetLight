# Environment Configuration for Smart Street Light Automation System

# Flask Server Config
SECRET_KEY=smartstreetlight-lora-super-secret-key-2026
PORT=5000
DEBUG=True

# Data Source Mode: 'synthetic' or 'hardware'
DEFAULT_DATA_SOURCE=synthetic

# HiveMQ Cloud MQTT Broker Configuration
# For HiveMQ Cloud: host is your-cluster-id.s1.eu.hivemq.cloud, port is 8883 (SSL/TLS)
# For public test: host=broker.hivemq.com, port=1883
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USE_TLS=False
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=SmartStreetLight_Server_01
MQTT_TOPIC_TELEMETRY=smartlight/telemetry/#
MQTT_TOPIC_COMMAND=smartlight/command/
MQTT_TOPIC_GATEWAY=smartlight/gateway/status

# Automation Defaults
DEFAULT_LDR_ON_THRESHOLD=50
DEFAULT_LDR_OFF_THRESHOLD=200
DEFAULT_NIGHT_BRIGHTNESS=80
DEFAULT_MOTION_BRIGHTNESS=100
DEFAULT_MOTION_TIMEOUT_SEC=30
COMMUNICATION_TIMEOUT_SEC=45
